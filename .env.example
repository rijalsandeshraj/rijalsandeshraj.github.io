# Optional. Without it the contact form falls back to opening the visitor's mail client.
# Create a free form at https://formspree.io and paste the endpoint here.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Only needed for GitHub Pages on a PROJECT page (username.github.io/<repo>).
# Leave empty for Vercel or for a user page (username.github.io).
NEXT_PUBLIC_BASE_PATH=
